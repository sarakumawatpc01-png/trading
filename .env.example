NODE_ENV=production
BACKEND_PORT=8080
REDIS_URL=redis://redis:6379
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
USE_INMEMORY_QUEUE=false
QUEUE_CONCURRENCY=5
PYTHON_SERVICE_URL=http://python-service:8000

# Required in production when ADMIN_API_ENFORCE=true
ADMIN_API_KEY=change-this-admin-key
ADMIN_API_ENFORCE=true

# Comma-separated origins allowed to call backend from browsers
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://trading.example.com
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=1
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=120

# Frontend runtime
NEXT_PUBLIC_API_BASE=/api/proxy
# Set to your public wss endpoint in production (optional for local)
NEXT_PUBLIC_WS_BASE=
BACKEND_INTERNAL_URL=http://backend:8080

# Python service
BACKEND_URL=http://backend:8080
PREFILTER_INTERVAL_SEC=15
PREFILTER_ONE_SEC_INTERVAL=1
PREFILTER_FIVE_SEC_INTERVAL=5
PREFILTER_SIXTY_SEC_INTERVAL=60
PREFILTER_CONFIG_REFRESH_SEC=30
PREFILTER_MOMENTUM_MODULUS=10
PREFILTER_VOLUME_MODULUS=7
PREFILTER_MOMENTUM_WEIGHT=0.6
PREFILTER_VOLUME_WEIGHT=0.4
PREFILTER_TRIGGER_THRESHOLD=4.2
